[global]
    monitor = 0
    follow = mouse
    width = 340
    height = (0, 340)
    origin = top-right
    offset = 20x48
    scale = 0
    notification_limit = 5
    
    progress_bar = true
    progress_bar_height = 12
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    
    indicate_hidden = yes
    transparency = 0
    separator_height = 1
    padding = 14
    horizontal_padding = 14
    text_icon_padding = 12
    frame_width = 1
    frame_color = "#3b322b"
    gap_size = 4
    separator_color = frame
    sort = yes
    idle_threshold = 120
    
    font = JetBrainsMono Nerd Font 10
    line_height = 2
    markup = full
    format = "<span weight='600' foreground='#e6d5b3'>%s</span>\n<span size='95%' foreground='#a89984'>%b</span>"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    
    icon_position = left
    min_icon_size = 24
    max_icon_size = 48
    enable_recursive_icon_lookup = true
    icon_theme = "Yaru-wartybrown-dark, Papirus-Dark, Adwaita"
    
    sticky_history = yes
    history_length = 30
    always_run_script = true
    corner_radius = 8
    ignore_dbusclose = false
    force_xinerama = false
    
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1a1613"
    foreground = "#7c6f64"
    frame_color = "#2f2722"
    highlight = "#7c6f64"
    timeout = 5
    default_icon = dialog-information

[urgency_normal]
    background = "#1a1613"
    foreground = "#a89984"
    frame_color = "#3b322b"
    highlight = "#b8652f"
    timeout = 8
    override_pause_level = 30
    default_icon = dialog-information

[urgency_critical]
    background = "#1a1613"
    foreground = "#e6d5b3"
    frame_color = "#a85050"
    highlight = "#a85050"
    timeout = 0
    override_pause_level = 60
    default_icon = dialog-warning
