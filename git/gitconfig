# Git — preferências compartilhadas, SEM identidade nem chave de assinatura.
# Incluído pelo ~/.gitconfig da máquina via [include] (install.sh adiciona).
# Nome, e-mail, signingkey e gpgsign ficam no ~/.gitconfig local.

[init]
	defaultBranch = main
[core]
	pager = less -FRX
[color]
	ui = auto
[color "branch"]
	current = "#7fb3c1" bold
	local = "#94a6ab"
	remote = "#6f9a7d"
[color "diff"]
	meta = "#6a8290"
	frag = "#a8966a"
	old = "#cf6b78"
	new = "#8fbc9a"
	whitespace = "#b35866" reverse
[color "status"]
	added = "#8fbc9a"
	changed = "#7fb3c1"
	untracked = "#6a8290"
[diff]
	algorithm = histogram
	colorMoved = dimmed-zebra
[fetch]
	prune = true
[push]
	autoSetupRemote = true
[rerere]
	enabled = true
[alias]
	st = status -sb
	lg = log --graph --format='%C(#7fb3c1)%h%C(reset) %C(#94a6ab)%ad%C(reset) %s %C(#6a8290)%an%C(auto)%d' --date=short
	last = log -1 --stat
	amend = commit --amend --no-edit
	unstage = restore --staged
