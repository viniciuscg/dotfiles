@import "colors.rasi"

* {
    background-color: @bg;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 10";
}

configuration {
    show-icons: false;
}

window {
    width:            200px;
    background-color: @bg;
    border:           1px;
    border-color:     @accent;
    border-radius:    8px;
    location:         northeast;
    x-offset:         -20;
    y-offset:         45;
}

mainbox {
    padding:          4px;
    background-color: @bg;
    children:         [ listview ];
}

listview {
    lines:            4;
    scrollbar:        false;
    background-color: @bg;
    spacing:          2px;
}

element {
    padding:          8px 12px;
    border-radius:    4px;
    background-color: @bg;
    cursor:           pointer;
}

element normal.normal {
    background-color: @bg;
    text-color:       @fg;
}

element hover {
    background-color: @bg-sel;
    text-color:       @fg-bright;
}

element selected.normal {
    background-color: @bg-sel;
    text-color:       @fg-bright;
}

element-text {
    text-color:       inherit;
    background-color: inherit;
}
