@import "colors.rasi"

* {
    background-color: @bg;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 10";
}

configuration {
    show-icons:        true;
    icon-theme:        "Yaru-wartybrown-dark";
    display-drun:      " Apps";
}

window {
    width:            380px;
    background-color: @bg;
    border:           1px;
    border-color:     @line;
    border-radius:    8px;
    location:         center;
}

mainbox {
    padding:          8px;
    background-color: @bg;
}

inputbar {
    background-color: @bg-alt;
    border-radius:    6px;
    padding:          8px 12px;
    margin:           0px 0px 8px 0px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:       @fg-bright;
    padding:          0px 6px 0px 0px;
}

entry {
    text-color:       @fg;
    placeholder:      "Search...";
    placeholder-color: @gray;
}

listview {
    lines:            7;
    scrollbar:        false;
    background-color: @bg;
    spacing:          2px;
}

element {
    padding:          8px 10px;
    border-radius:    4px;
    background-color: @bg;
}

element selected {
    background-color: @bg-sel;
}

element-text {
    text-color:       @fg;
    background-color: inherit;
}

element selected element-text {
    text-color: @fg-bright;
}

element-icon {
    size:             18px;
    background-color: inherit;
}
