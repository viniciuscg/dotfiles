@import "colors.rasi"

/**
 * Rofi para escolher wallpaper: lista + barra de pesquisa (filtra pastas/nomes).
 */
* {
    background-color: @bg;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 10";
}

configuration {
    show-icons: false;
}

window {
    width:            720px;
    background-color: @bg;
    border:           1px;
    border-color:     @accent;
    border-radius:    8px;
    location:         center;
}

mainbox {
    padding:          10px;
    background-color: @bg;
    spacing:          0px;
    children:         [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border-radius:    6px;
    padding:          10px 14px;
    margin:           0px 0px 10px 0px;
    spacing:          8px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:       @fg-bright;
    padding:          0px 4px 0px 0px;
}

entry {
    text-color:           @fg-bright;
    placeholder:          "Filtrar por pasta ou nome…";
    placeholder-color:    @gray;
    cursor:               text;
}

listview {
    lines:            18;
    scrollbar:        true;
    background-color: @bg;
    spacing:          4px;
    cycle:            true;
}

element {
    padding:          8px 12px;
    border-radius:    4px;
    background-color: @bg;
    cursor:           pointer;
}

element normal.normal {
    background-color: @bg;
    text-color:       @fg;
}

element hover {
    background-color: @bg-sel;
    text-color:       @fg-bright;
}

element selected.normal {
    background-color: @bg-sel;
    text-color:       @fg-bright;
}

element-text {
    text-color:       inherit;
    background-color: inherit;
}
